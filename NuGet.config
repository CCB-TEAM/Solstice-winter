<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      优先用仓库内的离线源（.nuget-local）：Nodify / AdonisUI / Msagl 的 nupkg 放在那里，
      避免依赖 nuget.org 可达性。
      注意：`.nuget-local/` **不进 git**（见 .gitignore），fresh clone 时它不存在，
      所以下面补了 nuget.org 兜底——否则别人 clone 下来连还原都过不去。
    -->
    <add key="local" value=".nuget-local" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
